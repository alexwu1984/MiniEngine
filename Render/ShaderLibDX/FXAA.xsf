#define FXAA_GREEN_AS_LUMA 0
#define FXAA_QUALITY__PRESET 39
#define XIN_FXAA_DEBUG 0

Texture2D Source : register(t0);
SamplerState LinearClampSampler : register(s0);

cbuffer ShaderParameter
{
    float2 FXAATexelSize;
    float1 FXAAEdgeThresholdMin;
    float1 FXAAEdgeThreshold;
    float1 FXAASubpix;
    float3 pad;
};

struct VertexOutput
{
    float2 Tex : TEXCOORD;
    float4 Pos : SV_Position;
};

// NVIDIA FXAA 3.11 body (PC, HLSL 5, preset 39, luma in alpha); no host shader macros.
#include "FXAA_3_11.xsh"

float4 FXAA_3_11_PixelShader(VertexOutput psInput) : SV_Target
{
    FxaaTex Input = { LinearClampSampler, Source };
    FxaaTex fxaaConsole360TexExpBiasNegOne;
    FxaaTex fxaaConsole360TexExpBiasNegTwo;
    return FxaaPixelShader(psInput.Tex, 0, Input, fxaaConsole360TexExpBiasNegOne, fxaaConsole360TexExpBiasNegTwo, FXAATexelSize, 0, 0, 0,
        FXAASubpix, FXAAEdgeThreshold, FXAAEdgeThresholdMin, 0, 0, 0, 0);
}
